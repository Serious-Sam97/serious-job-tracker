# Copy to .env. Dev works without a .env at all (defaults below are used).

# Database
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobtracker

# Login — off for local dev, on by default in docker-compose.prod.yml
AUTH_ENABLED=false
# 8+ characters
APP_PASSWORD=
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# true when served over HTTPS (e.g. behind a Cloudflare tunnel); false for plain http://localhost
COOKIE_SECURE=true

# Host ports (dev)
WEB_PORT=5173
API_PORT=4000
DB_PORT=5433

# Prod: nginx binds here (127.0.0.1 keeps it private to the host / tunnel)
WEB_BIND=127.0.0.1

# Prod: host port nginx listens on
PROD_PORT=8080
